#! /bin/sh

sdcard=/mnt/sdcard
flash_gl=/mnt/flash/extra_settings
ramdisk_gl=/var/run/gl
def_baudrate="115200"
gl_baudrate=${def_baudrate}
stop_timeout_in_sec=10
stop_counter=""
def_fix_start="normal"
par_fix_start=${def_fix_start}

stop_count() {
    echo ${stop_counter} | wc -c
}

stop_inc() {
    stop_counter=${stop_counter}"1"
}

start() {
    echo "* Starting gltt ${par_fix_start}"

    # Create the GL folder
    mkdir -p ${ramdisk_gl}

    # Create communication pipes for the application & fix
    mknod /var/run/gpspip2 p
	mknod /var/run/gpspipe p

    # Create log folder
    mkdir -p ${sdcard}/gl/log

    # get the gps receiver type (can we use ${hw_gpstype} here?)
    gpstype=`cat /proc/barcelona/gpstype`
    if [ ${gpstype} = 128 ]
    then
      rftype_param='-rftype HH_4L'
    elif [ ${gpstype} = 129 ]
    then
      rftype_param='-rftype HH_4L_INT_ON'
    else
      rftype_param=''
      echo "error determining rftype for gpstype $gpstype"
    fi

    # Start gltt
    # Debug switch: create gl/debug-gltt on the card to log the GPS engine
    # (LTO use, satellites, week handling) to gl/log/gltt.txt. Delete it to stop.
    if [ -f ${sdcard}/gl/debug-gltt ]; then
      gl_log=${sdcard}/gl/log/gltt.txt
      [ -f $gl_log ] && [ `wc -c < $gl_log` -gt 4000000 ] && mv -f $gl_log $gl_log.old
      echo "==== `date` start ${par_fix_start}" >> $gl_log
      LD_PRELOAD=${sdcard}/fixdate/glttconv.so /bin/gltt -baud ${gl_baudrate} -periodic 2000 -fix_start ${par_fix_start} ${rftype_param} -console_log >> $gl_log 2>&1 &
    else
      LD_PRELOAD=${sdcard}/fixdate/glttconv.so /bin/gltt -baud ${gl_baudrate} -periodic 2000 -fix_start ${par_fix_start} ${rftype_param} &
    fi
	
	# Start converter for gltt, restarting it whenever it quits.
	# Each restart is logged to gl/log/ttconv.log (capped at 20 KB).
	(
	  while true; do
	    ${sdcard}/bin/ttconv
	    lf=${sdcard}/gl/log/ttconv.log
	    [ -f $lf ] && [ `wc -c < $lf` -gt 20000 ] || echo "`date` up `cut -d' ' -f1 /proc/uptime`s ttconv exited, gltt `pidof gltt`" >> $lf
	    sleep 2
	  done
	) &
	echo $! > /var/run/ttconv-loop.pid
	
    # Get firmware version
    strings /bin/gltt | grep -e "@(#).*GLL" | awk '{printf "%s", $5;}' > /var/run/gps_version.txt &
}

stop() {
    echo "Stopping gltt"
    # Stop the ttconv restart loop and any ttconv still running
    [ -f /var/run/ttconv-loop.pid ] && kill `cat /var/run/ttconv-loop.pid` 2>/dev/null
    rm -f /var/run/ttconv-loop.pid
    killall ttconv 2>/dev/null
    # killall -KILL gltt
    killall gltt
    while [ `stop_count` -le ${stop_timeout_in_sec} ]; do
       pids=`pidof gltt`
       if [ -z "${pids}" ]; then
         echo "Stopping break"
         break;
       fi
       echo Stopping $stop_counter `stop_count`
       stop_inc
       sleep 1
    done
}

case "${1}" in
    start)
	if [ "${2}" = "" ] ; then 
          gl_baudrate=${def_baudrate}
	else 
          gl_baudrate=${2}
        fi
	if [ "${3}" = "" ] ; then 
          par_fix_start=${def_fix_start}
	else 
          par_fix_start=${3}
        fi
        start
        ;;

    stop)
        stop
        ;;

    *)
        echo "Usage: ${0} {start|stop} [baudrate] [fix_start]"
        exit 1
        ;;

esac

exit 0
